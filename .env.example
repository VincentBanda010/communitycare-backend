DATABASE_URL=postgresql://localhost:5432/communitycare
DATABASE_USER=communitycare
DATABASE_PASSWORD=
OIDC_ISSUER=https://identity.example.com/realms/communitycare
OIDC_AUDIENCE=communitycare-api
SYNC_ENCRYPTION_KEY=
DHIS2_URL=https://dhis.example.com
DHIS2_TOKEN=
DHIS2_PROGRAM=
DHIS2_STAGE=
DHIS2_TRIAGE_ELEMENT=
UPDATE_DIRECTORY=./updates

# Server-only native form configuration
NATIVE_AUTH_CLIENT_ID=communitycare-native-backend
NATIVE_AUTH_CLIENT_SECRET=
# Set only for the engineering-test pilot; leave blank for administrator assignment
NATIVE_REGISTRATION_PILOT_ORG=
NATIVE_AUTH_SMTP_ENABLED=false
# Local Gmail setup helper only; never put these values in Git
SMTP_USERNAME=
SMTP_APP_PASSWORD=

# Keep false for operational enrolment; true is only for a fixed engineering test pilot.
NATIVE_REGISTRATION_AUTO_ROLES=false
